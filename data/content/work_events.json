        {"day": 190, "text": "The new roadmap is out. Your project is in a box called \"Later\". Later has no date."},
        {"day": 210, "text": "Minh's desk is empty. The plant is gone. The badge reader beeps red at no one."},
        {"day": 235, "text": "Calendar invite from Dana: \"15 min sync\". No agenda. The room is called \"Opportunity\"."}
      ],
      "prep_after_sign": 3,
      "rumor": "All-hands: \"This year is about efficiency.\" The snacks are the first to go."
    },
    "pause": true,
    "focus": "meeting_room",
    "choices": [
      {"id": "update_profile", "text": "Update your profile", "effects": {"action": "board_early"}},
